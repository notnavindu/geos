// `npm run deploy` builds to dist/ and deploys the site plus the Worker in worker/index.ts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Created by the first deploy as "geos-orbits". Forking? Delete the id and `wrangler deploy` provisions your own.
  "kv_namespaces": [{ "binding": "ORBITS", "id": "43af7f22d14e4e44a2920e8387a534cc" }],
  // CelesTrak checks for new data every ~2 h and allows one download per update; every 4 h stays well inside that.
  "triggers": { "crons": ["17 */4 * * *"] },
  "observability": { "enabled": true }
}
